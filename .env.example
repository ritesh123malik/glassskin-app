# =============================================================================
# REQUIRED — Supabase (client-side)
# =============================================================================
# For local development:
#   iOS Simulator: http://127.0.0.1:54321
#   Android Emulator: http://10.0.2.2:54321
#   Web: http://localhost:54321
# For remote project: https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_USE_MOCKS=false

# =============================================================================
# REQUIRED — Expo / Push Notifications
# =============================================================================
# Your Expo project ID from expo.dev (required for production push tokens)
EXPO_PUBLIC_PROJECT_ID=your-expo-project-id

# =============================================================================
# REQUIRED — Stripe (client-side publishable key only)
# =============================================================================
# Secret key and webhook secret are set via EAS secrets / Supabase secrets.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# =============================================================================
# OPTIONAL — Google Maps / Places API (enables real address autocomplete)
# =============================================================================
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# =============================================================================
# OPTIONAL — PostHog Analytics
# =============================================================================
# POSTHOG_API_KEY=your-posthog-project-api-key
# POSTHOG_HOST=https://app.posthog.com
# For self-hosted PostHog, set POSTHOG_HOST to your instance URL (e.g. https://your-posthog.com)
# POSTHOG_HOST=

# =============================================================================
# OPTIONAL — PayPal (client credentials managed via EAS secrets)
# =============================================================================
# PAYPAL_CLIENT_ID=set-via-eas-secret
# PAYPAL_CLIENT_SECRET=set-via-eas-secret
# PAYPAL_ENV=sandbox  # or "live" for production

# =============================================================================
# Edge Function CORS — allowed browser origins (comma-separated)
# =============================================================================
# Production domains that may call Edge Functions from a browser.
# Localhost origins are always allowed during development.
# Example: APP_ORIGINS=https://glassskin.com,https://www.glassskin.com,https://app.glassskin.com
# APP_ORIGINS=

# =============================================================================
# Server-side Edge Function secrets (set with `supabase secrets set`)
# DO NOT expose these in client builds or commit to version control.
# =============================================================================
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=set-via-supabase-secret
# STRIPE_SECRET_KEY=set-via-supabase-secret
# STRIPE_WEBHOOK_SECRET=set-via-supabase-secret
# PAYPAL_WEBHOOK_ID=set-via-supabase-secret

