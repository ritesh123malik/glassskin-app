# Supabase Configuration
# For local development:
# iOS Simulator: http://127.0.0.1:54321
# Android Emulator: http://10.0.2.2:54321
# Web: http://localhost:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-supabase-anon-key
EXPO_PUBLIC_USE_MOCKS=false

# Expo Application
# Your Expo project ID from expo.dev (required for production push tokens)
EXPO_PUBLIC_PROJECT_ID=your-expo-project-id

# Stripe (client-side publishable key only — secret key lives in EAS secrets)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Google Maps / Places API (optional — enables real address autocomplete)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# PayPal (client credentials managed via EAS secrets — do NOT add secrets here)
# PAYPAL_CLIENT_ID=set-via-eas-secret
# PAYPAL_CLIENT_SECRET=set-via-eas-secret
# PAYPAL_ENV=sandbox  # or "live" for production
